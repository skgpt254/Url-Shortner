# ── App ──────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
# Comma-separated list of domains this service serves short links on.
# Used to reject self-referential ("shorten a shortlink") loops.
SHORTLINK_DOMAINS=short.example.com,go.example.com
# Public base URL used when returning full short-link strings from the API.
PUBLIC_BASE_URL=https://short.example.com
# Frontend origin(s) allowed to call this API with credentials, comma-separated.
# For the local docker-compose stack this is the frontend's own port.
ALLOWED_ORIGINS=http://localhost:5173

# ── Postgres ─────────────────────────────────────────────────────────
DATABASE_URL=postgres://shortlink:shortlink@localhost:5432/shortlink
DATABASE_POOL_MAX=20
DATABASE_POOL_IDLE_TIMEOUT_MS=30000
DATABASE_SSL=false

# ── Redis ────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_CACHE_TTL_SECONDS=3600

# ── Auth ─────────────────────────────────────────────────────────────
# 32+ byte random secrets. Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=changeme_access_secret_min_32_bytes_long
JWT_REFRESH_SECRET=changeme_refresh_secret_min_32_bytes_long
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Secret key for the Feistel short-code permutation. Rotating this
# invalidates the mapping for future codes only (existing codes are
# stored verbatim in DB and unaffected).
SHORTCODE_SECRET=changeme_shortcode_secret_min_32_bytes_long

# ── Rate limiting ────────────────────────────────────────────────────
RATE_LIMIT_ANONYMOUS_PER_MIN=30
RATE_LIMIT_AUTHENTICATED_PER_MIN=300
RATE_LIMIT_REDIRECT_PER_MIN=1000

# ── Third-party (optional, degrade gracefully if unset) ─────────────
GOOGLE_SAFE_BROWSING_API_KEY=
SENTRY_DSN=

# ── Analytics / privacy ──────────────────────────────────────────────
# Number of days raw click_events are retained before rollup + purge.
CLICK_EVENT_RETENTION_DAYS=90
# Salt used to hash visitor IPs before storage (never store raw IPs).
IP_HASH_SALT=changeme_ip_hash_salt
