# Leave EMPTY for local docker-compose (nginx proxies /api to the API
# container on the same origin — see nginx.conf).
#
# When deploying the frontend separately (e.g. Vercel) from the backend
# (e.g. Render), set this to the backend's public URL, no trailing slash:
#   VITE_API_BASE_URL=https://your-app.onrender.com
VITE_API_BASE_URL=
